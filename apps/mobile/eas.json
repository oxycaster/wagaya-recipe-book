      "env": {
        "IOS_BUNDLE_IDENTIFIER": "com.oxycastersorganization.wagayarecipe",
        "EXPO_PUBLIC_API_URL": "https://hiro-mac.tail6a2f57.ts.net:8443",
        "EXPO_PUBLIC_SUPABASE_URL": "https://hiro-mac.tail6a2f57.ts.net:8443",
        "EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "local-fixture"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
