PORT=4320
APP_ENV=dev
DATABASE_URL=postgresql://recipe:recipe@127.0.0.1:54329/recipe
# Production only: Crunchy Bridge team CA PEM. Keep it in the deployment secret manager.
DATABASE_SSL_CA=
# Clerk Frontend API URL used as the JWT issuer, without a trailing slash.
CLERK_ISSUER_URL=https://YOUR_INSTANCE.clerk.accounts.dev
# Comma-separated trusted azp values. Required in prod.
CLERK_AUTHORIZED_PARTIES=
# Worker only. Never expose this key through an EXPO_PUBLIC_ variable.
CLERK_SECRET_KEY=
AWS_REGION=ap-northeast-1
S3_BUCKET=
# Leave empty for AWS; endpoint is only for local S3-compatible testing.
S3_ENDPOINT=
# Lightsail uses a dedicated least-privilege IAM user. Its credentials live only in
# the CDK-managed runtime secret and are merged during deployment, never in this file.
OPENAI_API_KEY=
# Select a Responses + Structured Outputs compatible model available in your account.
OPENAI_MODEL=
# Low-cost first-pass model and configurable cost assumptions used for quotes.
OPENAI_SCAN_MODEL=gpt-4o-mini-2024-07-18
OPENAI_SCAN_INPUT_USD_PER_MILLION=0.15
OPENAI_SCAN_OUTPUT_USD_PER_MILLION=0.60
OPENAI_EXTRACTION_INPUT_USD_PER_MILLION=2.50
OPENAI_EXTRACTION_OUTPUT_USD_PER_MILLION=10.00
OPENAI_JPY_PER_USD=180
OPENAI_COST_JPY_PER_CREDIT=15
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_APP_ID=
# RevenueCat event environment. Use SANDBOX in dev and PRODUCTION in prod.
# Production accepts both live App Store and TestFlight sandbox events.
REVENUECAT_ENVIRONMENT=SANDBOX
# Product identifiers must match App Store Connect and RevenueCat consumables.
REVENUECAT_PRODUCTS={"com.oxycastersorganization.wagayarecipe.import10":10,"com.oxycastersorganization.wagayarecipe.import50":50}
