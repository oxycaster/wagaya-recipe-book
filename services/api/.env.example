PORT=4320
DATABASE_URL=postgresql://recipe:recipe@127.0.0.1:54329/recipe
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Worker only: Supabase secret/service-role key. Never use EXPO_PUBLIC_ for it.
SUPABASE_SECRET_KEY=
AWS_REGION=ap-northeast-1
S3_BUCKET=
# Leave empty for AWS; endpoint is only for local S3-compatible testing.
S3_ENDPOINT=
# Use an IAM task role in deployed environments; no AWS credentials in this repository.
OPENAI_API_KEY=
# Select a Responses + Structured Outputs compatible model available in your account.
OPENAI_MODEL=
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_APP_ID=
# Isolate SANDBOX and PRODUCTION databases and buckets.
REVENUECAT_ENVIRONMENT=SANDBOX
# Product identifiers must match App Store Connect and RevenueCat consumables.
REVENUECAT_PRODUCTS={"recipe_import_10":10,"recipe_import_50":50}
